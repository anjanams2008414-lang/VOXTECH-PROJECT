          <Route path="/games" element={<GenericPage title="Games" description="Light cognitive and therapeutic activities to keep progress engaging." cards={gameCards.map((game) => ({ title: game.name, detail: `${game.type} • Rated ${game.rating}`, icon: '??', badge: game.type }))} />} />
          <Route path="/community" element={<GenericPage title="Community" description="Support circles, peer groups, and shared care experiences." cards={communityItemsByRole[role].map((item) => ({ title: item.title, detail: item.detail, icon: '??', badge: item.badge }))} />} />
          <Route path="/analytics" element={<GenericPage {...routeCards.analytics[role]} />} />
