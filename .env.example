# Server Configuration
PORT=5001
APP_NAME=VOXTECH
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5175
JWT_SECRET=voxtech-jwt-secret-dev-key
AES_KEY=voxtech-dev-default-key-32-bytes-long
BCRYPT_ROUNDS=12
OTP_TTL_MS=60000

# Database Configuration (Optional)
# If left blank, the app will run seamlessly in built-in In-Memory mode.
# DATABASE_URL=postgresql://user:password@localhost:5432/voxtech

# Voice Assistant Providers (Optional / Fallback Dev Key included)
# Sarvam AI (Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEAKER=meera

# OpenAI Whisper (Optional STT Provider)
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1

# Email & SMS Delivery (Optional - for Auth OTPs)
# Option 1: Resend
RESEND_API_KEY=
RESEND_FROM="VOXTECH <onboarding@resend.dev>"

# Option 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Option 3: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 4: Appwrite Phone OTP
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
